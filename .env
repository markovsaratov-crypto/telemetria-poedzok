# Telemetria поездок — v2.6 (sandbox local dev)
# БД (sandbox: SQLite, prod: Turso/LibSQL)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Авторизация (single-user, §6.1) ---
# Пароль для /api/auth/login (≥32 символа). Сравнение timing-safe.
LOGIN_PASSWORD="change-me-please-32-chars-minimum-aaaaaa"
# Секрет для HMAC-подписи cookie (≥32 символа).
SESSION_SECRET="super-secret-session-key-32-chars-minimum"

# --- Bearer-токены (§6.1 таблица 8) ---
API_KEY="api-key-server-side-32-chars-minimum-xxx"
INGEST_TOKEN="ingest-token-32-chars-minimum-aaaaaaa"
CRON_SECRET="cron-secret-32-chars-minimum-bbbbbbbb"
ADMIN_TOKEN="admin-token-32-chars-minimum-cccccccc"

# --- Rate limiting (§6.3, §11) ---
# Блокер №1 FIX: поднято до 120 (TARGET_LOAD_RPM=100 × 1.2 headroom)
RATE_LIMIT_MAX_INGEST=120
RATE_LIMIT_MAX_DEFAULT=60
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_PLAN=5
RATE_LIMIT_MAX_AUDIT=60
RATE_LIMIT_MAX_ADMIN=1
RATE_LIMIT_BACKEND=memory
# REDIS_URL= (нет в sandbox — in-memory fallback)

# --- Payload limits ---
MAX_PAYLOAD_BYTES=262144

# --- Worker (§9.6) ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_ID="worker-sandbox-01"
WORKER_BATCH_SIZE=10
WORKER_MAX_CONCURRENCY=5
# Порт Worker mini-service (mini-services/worker)
WORKER_PORT=3001

# --- Routing (§3.2) ---
TWO_GIS_API_KEY=""
OSRM_BASE_URL="https://router.project-osrm.org"
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SEC=30

# --- Retention (§3.7) ---
RETENTION_DAYS=3650
RETENTION_ARCHIVE_ENABLED=true
ARCHIVE_RETENTION_DAYS=3650
GRACE_PERIOD_DAYS=30
AUDIT_RETENTION_DAYS=3650

# --- Export (§4.11) ---
EXPORT_ASYNC_THRESHOLD=5000
EXPORT_STORAGE_DIR="/home/z/my-project/download/exports"
EXPORT_URL_TTL_HOURS=24
EXPORT_MAX_FILE_BYTES=104857600

# --- Backup (§9.8) ---
BACKUP_MAX_ATTEMPTS=3
BACKUP_RETRY_INTERVAL_HOURS=1
BACKUP_VERIFICATION_ENABLED=true
BACKUP_STORAGE_DIR="/home/z/my-project/download/backups"

# --- Scale / CI (§3.9, §9.6) ---
VERCEL_PLAN="pro"
TARGET_LOAD_RPM=100

# --- App ---
NODE_ENV="development"
APP_VERSION="2.6.0"
