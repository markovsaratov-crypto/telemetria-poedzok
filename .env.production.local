# v2.37.0 (Task 43, 16.09.2026): миграция БД Turso → Cloudflare D1.
# Файл загружается next start при старте сервера (@next/env, NODE_ENV=production);
# переменные дашборда Render имеют приоритет и НЕ перекрываются (стандарт Next).
# ОТКАТ миграции: удалить этот файл + redeploy → приложение вернётся на Turso
# (DATABASE_URL/TURSO_AUTH_TOKEN в окружении Render не тронуты).
D1_GATEWAY_URL=https://d1-gateway.markov-saratov.workers.dev
D1_GATEWAY_SECRET=***REMOVED-СЕКРЕТ-РОТИРОВАН***
# Стартовый интервал опроса воркера; дальше адаптивно (idle 30с, нагрузка 2-5с)
WORKER_POLL_INTERVAL_MS=15000
