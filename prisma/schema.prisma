// Telemetria поездок — Prisma schema v3.1 (multi-user, methodology v2.9)
// v2.9: added Session.routeHash (deterministic hash for grouping conceptual-same
// routes per §10.0 methodology) + Session.topologyHash (8-char hash of key
// route points, also per §10.0). Note: existing Session.routeId is the FK to
// admin-created Route — conceptually different from methodology's "routeId".
// In API responses, "routeHash" returns the v2.9 deterministic hash; "routeId"
// returns the admin FK (unchanged from v2.7).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  apiKey       String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  routes       Route[]
  auditLogs    AuditLog[]
  @@index([role])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  userId       String?
  id           String    @id @default(cuid())
  deviceId     String
  clientId     String?
  deviceName   String?
  startTime    DateTime
  endTime      DateTime?
  pointCount   Int       @default(0)
  payloadBytes Int       @default(0)
  status       String    @default("active")
  deletedAt    DateTime?
  purgedAt     DateTime?
  routeId      String?
  routeHash    String?   // v2.9 §10.0: deterministic 16-char hash for grouping conceptual-same routes (snap-to-grid + topology)
  topologyHash String?   // v2.9 §10.0: 8-char hash of key route points (intermediate value, indexed for debugging)
  trafficJobId String?
  // v2.26.0 (ТЗ «Поездка не рвётся», §6): ПОСЛЕДНЯЯ поездка записи (навигация).
  // Запись может входить в НЕСКОЛЬКО поездок (запись на весь рабочий день =
  // утренняя + вечерняя поездки) — канонический состав хранит Trip.sessionIds
  // (JSON-массив); это поле денормализовано для быстрых запросов/диагностики.
  tripId       String?
  notes        String?
  tags         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  route       Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  gpsPoints   GpsPoint[]
  trafficJobs TrafficJob[]
  auditLogs   AuditLog[]
  exportJobs  ExportJob[]
  trips       Trip[]      @relation("SessionTrips")

  @@unique([deviceId, clientId])
  @@index([status, endTime])
  @@index([routeId])
  @@index([routeHash])     // v2.9: для сравнительных метрик (RouteAvgDuration, RouteTrend, HotspotSegments)
  @@index([topologyHash])  // v2.9: для отладки и группировки по топологии
  @@index([deletedAt])
  @@index([startTime])
  @@index([tripId])        // v2.26.0: поездка записи (навигация/диагностика)
}

// v2.26.0 (ТЗ «Поездка не рвётся на куски», §4/§6): каноническая сущность
// «Поездка» = максимальная последовательность активного движения устройства.
// Граница — ЧИСТАЯ ФУНКЦИЯ ПОТОКА ТОЧЕК: интервал между соседними точками
// ≥ TRIP_SPLIT_SEC (900 c) ИЛИ стоянка (нулевое перемещение при точках)
// ≥ TRIP_SPLIT_SEC. Единая семантика с ACTIVE_TRIP_STOP_SPLIT_SEC (v2.25 legs):
// «остановка ≥ 15 минут = новая поездка» независимо от того, молчал логгер
// (тишина/разрыв потока) или писал парковочный дрейф. Запись (Session)
// остаётся ТРАНСПОРТНЫМ фрагментом: тишина пуша > SESSION_GAP_MS (60 c)
// режет только записи. Кэш-поля метрик — конвенция Session §6.1: null =
// «не посчитано», расчёт on-demand, инвалидация при изменении состава.
model Trip {
  id           String    @id @default(cuid())
  deviceId     String
  // Модель владения v2.23.0 (изоляция данных), копия с записей: NULL = хозяйские
  userId       String?
  status       String    @default("recording") // recording | completed
  // Окно ПОЕЗДКИ (= leg-окно v2.25): от первого до последнего ДВИЖЕНИЯ;
  // стоянки-«хвосты» записей и парковки между поездками НЕ входят
  startTime    DateTime            // мс первого движения
  endTime      DateTime?           // мс последнего движения
  spanStart    DateTime            // первый фикс охватываемых записей
  spanEnd      DateTime?           // последний фикс охватываемых записей
  startLat     Float?
  startLon     Float?
  endLat       Float?
  endLon       Float?
  sessionIds   String    @default("[]") // JSON id записей — канонический состав
  sessionCount Int       @default(0)
  deletedAt    DateTime?
  trafficJobId String?   // план-факт: один TrafficJob на поездку (§9 ТЗ)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activeDurationSec   Float?
  movingTimeSec       Float?
  idleTimeSec         Float?
  gapTimeSec          Float?
  interFragmentGapSec Float?
  internalStopTimeSec Float?
  distanceM           Float?
  pointCountActual    Int?
  maxSpeedMs          Float?
  ecoScore            Float?
  planDistanceM       Float?
  planDurationSec     Float?
  planComparable      Boolean?
  planCoverage        Float?
  routingLegCount     Int?
  statsComputedAt     DateTime?

  sessions     Session[]   @relation("SessionTrips")

  @@index([deviceId, spanStart])
  @@index([userId, spanStart])
  @@index([status, spanEnd])
  @@index([deletedAt])
}

model GpsPoint {
  id        String  @id @default(cuid())
  sessionId String
  lat       Float
  lon       Float
  speed     Float?
  altitude  Float?
  accuracy  Float?
  timestamp BigInt
  bearing   Float?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, timestamp])
}

model Route {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  startLat    Float
  startLon    Float
  endLat      Float
  endLon      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions    Session[]
  routeCaches RouteCache[]

  @@index([userId])
}

model RouteCache {
  id        String   @id @default(cuid())
  hash      String   @unique
  result    String
  todBucket Int
  routeId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  route Route? @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([todBucket, expiresAt])
  @@index([routeId])
}

model TrafficJob {
  id           String    @id @default(cuid())
  // v2.26.0 (ТЗ §6): задание маршрутизации сессии ИЛИ поездки. Инвариант
  // приложения (проверяется на записи, §16 ТЗ): заполнен РОВНО ОДИН из
  // sessionId / tripId. Существующие строки — только sessionId (поездковых
  // до v2.26 не существовало).
  sessionId    String?
  tripId       String?
  status       String    @default("pending")
  attempts     Int       @default(0)
  priority     Int       @default(0)
  scheduledFor DateTime  @default(now())
  lockedBy     String?
  lockedAt     DateTime?
  result       String?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor, priority])
  @@index([sessionId])
  @@index([tripId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetId   String
  targetType String
  actorType  String
  actorId    String?
  metadata   String?
  sessionId  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetId, targetType])
  @@index([actorType, actorId])
  @@index([sessionId])
  @@index([userId])
}

model ExportJob {
  id          String    @id @default(cuid())
  sessionId   String
  format      String
  status      String    @default("pending")
  fileUrl     String?
  fileSize    Int?
  expiresAt   DateTime?
  attempts    Int       @default(0)
  lockedBy    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sessionId])
}

model BackupJob {
  id           String    @id @default(cuid())
  status       String    @default("pending")
  type         String    @default("full")
  filePath     String?
  fileSize     Int?
  checksum     String?
  attempts     Int       @default(0)
  lockedBy     String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  error        String?

  @@index([status, createdAt])
}

model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @default(now()) @updatedAt
  updatedBy  String?
}

// v2.11.0 (АУДИТ C-14): идемпотентность инжеста SensorLogger по (deviceId, messageId).
// HTTP-ретраи приложения больше не создают дубликаты GPS-точек.
model IngestMessage {
  deviceId    String
  messageId   String
  firstSeenAt DateTime @default(now())

  @@id([deviceId, messageId])
  @@index([firstSeenAt])
}
