// Telemetria поездок — Prisma schema v2.6
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/local.db"
}

model Session {
  id           String    @id @default(cuid())
  deviceId     String
  clientId     String?
  deviceName   String?
  startTime    DateTime
  endTime      DateTime?
  pointCount   Int       @default(0)
  payloadBytes Int       @default(0)
  status       String    @default("active")
  deletedAt    DateTime?
  purgedAt     DateTime?
  routeId      String?
  trafficJobId String?
  notes        String?
  tags         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  route       Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  gpsPoints   GpsPoint[]
  trafficJobs TrafficJob[]
  auditLogs   AuditLog[]
  exportJobs  ExportJob[]

  @@unique([deviceId, clientId])
  @@index([status, endTime])
  @@index([routeId])
  @@index([deletedAt])
  @@index([startTime])
}

model GpsPoint {
  id        String  @id @default(cuid())
  sessionId String
  lat       Float
  lon       Float
  speed     Float?
  altitude  Float?
  accuracy  Float?
  timestamp BigInt
  bearing   Float?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, timestamp])
}

model Route {
  id          String   @id @default(cuid())
  name        String
  description String?
  startLat    Float
  startLon    Float
  endLat      Float
  endLon      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  routeCaches RouteCache[]
}

model RouteCache {
  id        String   @id @default(cuid())
  hash      String   @unique
  result    String
  todBucket Int
  routeId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  route Route? @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([todBucket, expiresAt])
  @@index([routeId])
}

model TrafficJob {
  id           String    @id @default(cuid())
  sessionId    String
  status       String    @default("pending")
  attempts     Int       @default(0)
  priority     Int       @default(0)
  scheduledFor DateTime  @default(now())
  lockedBy     String?
  lockedAt     DateTime?
  result       String?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor, priority])
  @@index([sessionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetId   String
  targetType String
  actorType  String
  actorId    String?
  metadata   String?
  sessionId  String?
  createdAt  DateTime @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetId, targetType])
  @@index([actorType, actorId])
  @@index([sessionId])
}

model ExportJob {
  id          String    @id @default(cuid())
  sessionId   String
  format      String
  status      String    @default("pending")
  fileUrl     String?
  fileSize    Int?
  expiresAt   DateTime?
  attempts    Int       @default(0)
  lockedBy    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sessionId])
}

model BackupJob {
  id           String    @id @default(cuid())
  status       String    @default("pending")
  type         String    @default("full")
  filePath     String?
  fileSize     Int?
  checksum     String?
  attempts     Int       @default(0)
  lockedBy     String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  error        String?

  @@index([status, createdAt])
}

/// Runtime-overridable settings (key-value store).
/// Позволяет менять настройки (например TWO_GIS_API_KEY) без redeploy.
/// Читается in-process worker'ом и API routes через settings.ts cache.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}
