// Telemetria поездок — Prisma schema v3.1 (multi-user, methodology v2.9)
// v2.9: added Session.routeHash (deterministic hash for grouping conceptual-same
// routes per §10.0 methodology) + Session.topologyHash (8-char hash of key
// route points, also per §10.0). Note: existing Session.routeId is the FK to
// admin-created Route — conceptually different from methodology's "routeId".
// In API responses, "routeHash" returns the v2.9 deterministic hash; "routeId"
// returns the admin FK (unchanged from v2.7).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  apiKey       String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  routes       Route[]
  auditLogs    AuditLog[]
  // v2.38.2 (ревью F56): @@index([role]) УДАЛЁН — индекса User_role_idx в
  // прод-D1 НЕТ (схема врала о несуществующем объекте — тот же класс дрифта,
  // что _SessionTrips/GpsPoint_sessionId_idx из v2.38.1/F26), а запросов по
  // role приложение не имеет (фильтрация — по id/email/apiKey; селективность
  // role ~2 значения — индекс и не нужен). Схема = фактическая прод-схема.
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  userId       String?
  id           String    @id @default(cuid())
  deviceId     String
  clientId     String?
  deviceName   String?
  startTime    DateTime
  endTime      DateTime?
  pointCount   Int       @default(0)
  payloadBytes Int       @default(0)
  status       String    @default("active")
  deletedAt    DateTime?
  purgedAt     DateTime?
  routeId      String?
  routeHash    String?   // v2.9 §10.0: deterministic 16-char hash for grouping conceptual-same routes (snap-to-grid + topology)
  topologyHash String?   // v2.9 §10.0: 8-char hash of key route points (intermediate value, indexed for debugging)
  trafficJobId String?
  // v2.26.0 (ТЗ «Поездка не рвётся», §6): ПОСЛЕДНЯЯ поездка записи (навигация).
  // Запись может входить в НЕСКОЛЬКО поездок (запись на весь рабочий день =
  // утренняя + вечерняя поездки) — канонический состав хранит Trip.sessionIds
  // (JSON-массив); это поле денормализовано для быстрых запросов/диагностики.
  tripId       String?
  notes        String?
  tags         String?
  // v2.27.0 (ПЕРФ-КЭШ, конвенция §6.1 как у Trip): предвычисленные payloads
  // батч-роутов. null = «не посчитано». Инвалидация: cachePointCount ≠
  // pointCount (инжест инкрементит pointCount) или cacheVersion устарел.
  // statsCache — сериализованный SessionStatsResult (без route: план-факт
  // дорабатывается воркером ПОСЛЕ финализации и всегда собирается живым);
  // eventsCache — SessionEventsPayload; trackCache — TrackPayload.
  statsCache    String?
  eventsCache   String?
  trackCache    String?
  cachePointCount Int?
  cacheVersion  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  route       Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  gpsPoints   GpsPoint[]
  trafficJobs TrafficJob[]
  auditLogs   AuditLog[]
  exportJobs  ExportJob[]
  // v2.38.1 (ревью F26): НЕЯВНАЯ m-n связь с Trip (@relation("SessionTrips"))
  // УДАЛЕНА — она порождала join-таблицу _SessionTrips, которой в прод-D1 НЕТ
  // (состав поездки хранится в Trip.sessionIds JSON — см. OPERATIONS.md §5).
  // Схема теперь отражает фактическую прод-схему: db:push больше не пытается
  // создать/дропнуть несуществующие объекты.

  @@unique([deviceId, clientId])
  @@index([status, endTime])
  @@index([routeId])
  @@index([routeHash])     // v2.9: для сравнительных метрик (RouteAvgDuration, RouteTrend, HotspotSegments)
  @@index([topologyHash])  // v2.9: для отладки и группировки по топологии
  @@index([deletedAt])
  @@index([startTime])
  @@index([tripId])        // v2.26.0: поездка записи (навигация/диагностика)
  // v2.38.2 (ревью F50): индекс списковых запросов. ВСЕ списковые/агрегатные
  // чтения фильтруют userId = ?/IS NULL и сортируют по startTime (scope-предикаты
  // роутов, db.session.findMany/count/aggregate) — без индекса каждый такой
  // запрос full-scan (выжигает rows_read-квоту D1; RETENTION_DAYS=3650 = годы
  // роста). У Trip парный [userId, spanStart] был с v2.26. Реальное DDL —
  // идемпотентный ensure-on-boot в src/lib/db.ts (ensureSessionIndexes):
  // Prisma здесь — только типы; на прод-D1 индекс строится при первом деплое
  // (после расширения DDL-вайтлиста шлюза — см. комментарий F50 в db.ts).
  @@index([userId, startTime])
}

// v2.26.0 (ТЗ «Поездка не рвётся на куски», §4/§6): каноническая сущность
// «Поездка» = максимальная последовательность активного движения устройства.
// Граница — ЧИСТАЯ ФУНКЦИЯ ПОТОКА ТОЧЕК: интервал между соседними точками
// ≥ TRIP_SPLIT_SEC (900 c) ИЛИ стоянка (нулевое перемещение при точках)
// ≥ TRIP_SPLIT_SEC. Единая семантика с ACTIVE_TRIP_STOP_SPLIT_SEC (v2.25 legs):
// «остановка ≥ 15 минут = новая поездка» независимо от того, молчал логгер
// (тишина/разрыв потока) или писал парковочный дрейф. Запись (Session)
// остаётся ТРАНСПОРТНЫМ фрагментом: тишина пуша > SESSION_GAP_MS (60 c)
// режет только записи. Кэш-поля метрик — конвенция Session §6.1: null =
// «не посчитано», расчёт on-demand, инвалидация при изменении состава.
model Trip {
  id           String    @id @default(cuid())
  deviceId     String
  // Модель владения v2.23.0 (изоляция данных), копия с записей: NULL = хозяйские
  userId       String?
  status       String    @default("recording") // recording | completed
  // Окно ПОЕЗДКИ (= leg-окно v2.25): от первого до последнего ДВИЖЕНИЯ;
  // стоянки-«хвосты» записей и парковки между поездками НЕ входят
  startTime    DateTime            // мс первого движения
  endTime      DateTime?           // мс последнего движения
  spanStart    DateTime            // первый фикс охватываемых записей
  spanEnd      DateTime?           // последний фикс охватываемых записей
  startLat     Float?
  startLon     Float?
  endLat       Float?
  endLon       Float?
  sessionIds   String    @default("[]") // JSON id записей — канонический состав
  sessionCount Int       @default(0)
  deletedAt    DateTime?
  trafficJobId String?   // план-факт: один TrafficJob на поездку (§9 ТЗ)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activeDurationSec   Float?
  movingTimeSec       Float?
  idleTimeSec         Float?
  gapTimeSec          Float?
  interFragmentGapSec Float?
  internalStopTimeSec Float?
  distanceM           Float?
  pointCountActual    Int?
  maxSpeedMs          Float?
  ecoScore            Float?
  planDistanceM       Float?
  planDurationSec     Float?
  planComparable      Boolean?
  planCoverage        Float?
  routingLegCount     Int?
  statsComputedAt     DateTime?

  // v2.38.1 (ревью F26): обратная m-n связь с Session удалена вместе с
  // @relation("SessionTrips") на Session — _SessionTrips в прод-D1 не существует.

  @@index([deviceId, spanStart])
  @@index([userId, spanStart])
  @@index([status, spanEnd])
  @@index([deletedAt])
}

model GpsPoint {
  id        String  @id @default(cuid())
  sessionId String
  lat       Float
  lon       Float
  speed     Float?
  altitude  Float?
  accuracy  Float?
  timestamp BigInt
  bearing   Float?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // v2.38.1 (ревью F26): одиночный @@index([sessionId]) УДАЛЁН — в прод-D1
  // индекса GpsPoint_sessionId_idx НЕТ (избыточен: составной индекс ниже
  // покрывает все запросы по sessionId; см. OPERATIONS.md §5 «Лимиты и
  // особенности D1»). Схема = фактическая прод-схема (schema drift закрыт).
  // v2.38.2 (ревью F56): ревизия дрифта завершена — НЕСУЩЕСТВУЮЩИХ объектов в
  // схеме больше нет (User_role_idx удалён выше; _SessionTrips и
  // GpsPoint_sessionId_idx — v2.38.1). Рантайм-таблицы вне prisma-моделей
  // (_AlertState, ShareToken, _ExportJobLock) создаются ensure-on-boot DDL в
  // коде — в схеме не отражаются (тот же статус, что у _AlertState).
  @@index([sessionId, timestamp])
}

model Route {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  startLat    Float
  startLon    Float
  endLat      Float
  endLon      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions    Session[]
  routeCaches RouteCache[]

  @@index([userId])
}

model RouteCache {
  id        String   @id @default(cuid())
  hash      String   @unique
  result    String
  todBucket Int
  routeId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  route Route? @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([todBucket, expiresAt])
  @@index([routeId])
}

model TrafficJob {
  id           String    @id @default(cuid())
  // v2.26.0 (ТЗ §6): задание маршрутизации сессии ИЛИ поездки. Инвариант
  // приложения (проверяется на записи, §16 ТЗ): заполнен РОВНО ОДИН из
  // sessionId / tripId. Существующие строки — только sessionId (поездковых
  // до v2.26 не существовало).
  sessionId    String?
  tripId       String?
  status       String    @default("pending")
  attempts     Int       @default(0)
  priority     Int       @default(0)
  scheduledFor DateTime  @default(now())
  lockedBy     String?
  lockedAt     DateTime?
  result       String?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor, priority])
  @@index([sessionId])
  @@index([tripId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetId   String
  targetType String
  actorType  String
  actorId    String?
  metadata   String?
  sessionId  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetId, targetType])
  @@index([actorType, actorId])
  @@index([sessionId])
  @@index([userId])
}

model ExportJob {
  id          String    @id @default(cuid())
  sessionId   String
  format      String
  status      String    @default("pending")
  fileUrl     String?
  fileSize    Int?
  expiresAt   DateTime?
  attempts    Int       @default(0)
  lockedBy    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sessionId])
}

model BackupJob {
  id           String    @id @default(cuid())
  status       String    @default("pending")
  type         String    @default("full")
  filePath     String?
  fileSize     Int?
  checksum     String?
  attempts     Int       @default(0)
  lockedBy     String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  error        String?

  @@index([status, createdAt])
}

model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @default(now()) @updatedAt
  updatedBy  String?
}

// v2.11.0 (АУДИТ C-14): идемпотентность инжеста SensorLogger по (deviceId, messageId).
// HTTP-ретраи приложения больше не создают дубликаты GPS-точек.
model IngestMessage {
  deviceId    String
  messageId   String
  firstSeenAt DateTime @default(now())

  @@id([deviceId, messageId])
  @@index([firstSeenAt])
}

// v2.39.0 (§A1, docs/OPTIMIZATION-PROPOSAL.md Вариант A): дневные rollup-агрегаты
// дашборда — materialized-rollup паттерн (CQRS-lite): дашборд читает O(дней) строк
// StatsRollup вместо COUNT(*) по всей GpsPoint (главный удар по дневной квоте
// чтений D1). day — YYYY-MM-DD в TZ владельца (TELEMAT_TIMEZONE, паттерн TZ-бакетов
// v2.38.2 §F68); userId NULL = «все/unclaimed» (как Session.userId, модель
// владения v2.23.0). Пишется: (а) инкрементами инжеста (points+N, sessions+N),
// (б) ленивым cache-aside-заполнением/бэкфиллом из Session (SUM(pointCount) —
// денормализация v2.26+, дистанция/длительность/эко — из Session.statsCache).
// РЕАЛЬНОЕ DDL — идемпотентный ensure-on-boot в src/lib/stats-rollup.ts
// (паттерн _AlertState/ensureSessionIndexes F50: вайтлист DDL шлюза может
// требовать расширения; Prisma здесь — только типы, как у рантайм-таблиц).
// NB: в ТЗ §A1 поле значилось как `userId String?` (NULL = unclaimed), но
// SQLite не детектит ON CONFLICT по NULL-компоненте PK (NULL ≠ NULL → дубли
// и потерянные инкременты) — поэтому НЕ-NULL с sentinel-пустой строкой:
// userId = "" означает «unclaimed/все» (семантика Session.userId IS NULL
// сохранена на уровне API-конвертации rollupUserId(scope) ниже по стеку).
model StatsRollup {
  day         String   // YYYY-MM-DD в TELEMAT_TIMEZONE
  userId      String   @default("") // "" = все/unclaimed (см. NB выше)
  sessions    Int      @default(0)
  points      Int      @default(0)
  distanceM   Float    @default(0)
  durationSec Int      @default(0)
  ecoSum      Float    @default(0)
  ecoCount    Int      @default(0)
  updatedAt   DateTime

  @@id([day, userId])
  @@index([userId, day])
}
